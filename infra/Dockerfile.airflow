FROM apache/airflow:3.3.2-python3.12

USER root
RUN apt-get update && apt-get install --no-install-recommends -y libgomp1 && rm -rf /var/lib/apt/lists/*
USER airflow

COPY --chown=airflow:0 infra/requirements.airflow.txt /tmp/requirements.airflow.txt
RUN pip install --no-cache-dir "apache-airflow==3.3.2" -r /tmp/requirements.airflow.txt
